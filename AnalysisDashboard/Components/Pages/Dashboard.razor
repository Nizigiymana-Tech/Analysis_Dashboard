@page "/dashboard"
@using AnalysisDashboard.Services
@inject CsvDataService CsvData
@rendermode InteractiveServer

<h2>Uploaded Dataset</h2>

@if (string.IsNullOrEmpty(CsvData.CsvContent))
{
    <p>No CSV file uploaded.</p>
}
else
{
    <table>
        @foreach (string[] row in rows)
        {
            <tr>
                @foreach (string value in row)
                {
                    <td>@value</td>
                }
            </tr>
        }
    </table>
}

@code {
    private string[][] rows = Array.Empty<string[]>();

    protected override void OnInitialized()
    {
        rows = GetRows();
    }

    private string[][] GetRows()
    {
        string data = CsvData.CsvContent;
        string[] dataSplit = data.Split('\n');

        List<string[]> rows = new List<string[]>();

        foreach (string value in dataSplit)
        {
            if (string.IsNullOrWhiteSpace(value))
            {
                continue;
            }

            string[] newValue = value.Split(",");
            rows.Add(newValue);
        }

        return rows.ToArray();
    }
}